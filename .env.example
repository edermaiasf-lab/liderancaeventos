# Copie para .env (local) ou cadastre em Cloudflare Pages > Settings > Variables and Secrets.
# Endereço oficial do site (canonical, sitemap, Open Graph, dados estruturados).
# Vazio = usa o PADRAO de astro.config.mjs (hoje https://liderancaeventos.pages.dev).
SITE_URL=
# ID do Google Analytics 4. Vazio = nada do Google Analytics é carregado.
PUBLIC_GA_ID=G-RCEXG8T5G7
# Código da meta tag de verificação do Google Search Console (só o valor de content="...")
PUBLIC_GSC_VERIFICATION=
