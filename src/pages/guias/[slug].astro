---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Arrow from '../../components/Arrow.astro';
import InfoCard from '../../components/InfoCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { guias } from '../../data/guias';
import { site } from '../../data/conteudo';

export function getStaticPaths() {
  return guias.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props;
const dataBR = new Date(g.data + 'T12:00:00').toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' });
const artigo = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: g.titulo, description: g.resumo,
  datePublished: g.data, dateModified: g.data, inLanguage: 'pt-BR',
  image: new URL(`/og/${g.img}.jpg`, Astro.site).href, mainEntityOfPage: new URL(`/guias/${g.slug}/`, Astro.site).href,
  author: { '@type': 'Organization', name: site.nome }, publisher: { '@id': new URL('/#org', Astro.site).href },
};
const crumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: new URL('/', Astro.site) },
    { '@type': 'ListItem', position: 2, name: 'Guias', item: new URL('/guias/', Astro.site) },
    { '@type': 'ListItem', position: 3, name: g.titulo },
  ],
};
---
<Base title={`${g.titulo} | Guias Liderança`} description={g.resumo} image={g.img} schema={[artigo, crumbSchema]}>
  <PageHero eyebrow={`Guia · ${dataBR}`} title={g.titulo} lead={g.resumo} img={g.img} pos="center 55%" crumbs={[{ label: 'Guias', href: '/guias/' }, { label: g.titulo }]} />
  <section class="sec tight">
    <div class="wrap detail">
      <article class="detail-main prose-local">
        {g.secoes.map((s) => (
          <>
            {s.h && <h2 data-reveal>{s.h}</h2>}
            {s.p?.map((t) => <p data-reveal>{t}</p>)}
            {s.lista && <ul class="guia-lista" data-reveal>{s.lista.map((i) => <li>{i}</li>)}</ul>}
          </>
        ))}
        <p class="note-s" data-reveal style="margin-top:30px">Leia também: {g.relacionados.map(([t, h], i) => <>{i > 0 && ' · '}<a href={h}>{t}</a></>)}.</p>
      </article>
      <InfoCard title="O Liderança" rows={[['Onde', 'Abadia de Goiás – GO'], ['Capacidade', `até ${site.capacidade} pessoas`], ['Diária', 'das 09h às 22h'], ['Reserva', 'com 50% de sinal']]} />
    </div>
  </section>
  <CtaBand />
</Base>
