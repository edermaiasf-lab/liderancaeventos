---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Arrow from '../components/Arrow.astro';
---
<Base title="Página não encontrada | Liderança Espaço de Eventos" description="Página não encontrada." image="piscina-noite">
  <PageHero eyebrow="Erro 404" title="Essa página <em>não existe.</em>" lead="O endereço pode ter mudado. Volte ao início ou veja o espaço." img="piscina-noite" alt="Piscina à noite" caption="Fotografia — piscina à noite.">
    <p class="btns"><a class="btn gold" href="/">Ir para o início <Arrow /></a><a class="btn line-d" href="/espaco/">Ver o espaço <Arrow /></a></p>
  </PageHero>
</Base>
