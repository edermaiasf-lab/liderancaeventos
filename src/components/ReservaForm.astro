---
import { site } from '../data/conteudo';
const tipos = ['Aniversário', 'Festa infantil', 'Casamento', 'Chá de bebê / revelação', 'Confraternização', 'Outro'];
const duracoes = [['4', '4h'], ['6', '6h'], ['8', '8h'], ['13', 'Dia todo']];
---
<form class="form" id="reserva" novalidate data-whats={site.whats} data-max={site.capacidade} data-reveal>
  <fieldset>
    <legend>Tipo de evento</legend>
    <div class="chips">
      {tipos.map((t, i) => <label><input type="radio" name="evento" value={t} checked={i === 0} /><span>{t}</span></label>)}
    </div>
  </fieldset>

  <div class="field">
    <label for="f-data">Data <abbr title="obrigatório">*</abbr></label>
    <div class="quick" id="quick" aria-label="Próximas sextas e sábados"></div>
    <input type="date" id="f-data" name="data" required />
    <small class="err" id="err-data" role="alert"></small>
  </div>

  <div class="row">
    <div class="field">
      <label for="f-ini">Começa às</label>
      <select id="f-ini" name="inicio"></select>
    </div>
    <fieldset class="field">
      <legend>Duração</legend>
      <div class="durs">
        {duracoes.map(([v, l], i) => <label><input type="radio" name="dur" value={v} checked={i === 3} /><span>{l}</span></label>)}
      </div>
    </fieldset>
  </div>
  <p class="form-hint" id="form-hint">A diária vai das 09h às 22h.</p>

  <div class="row">
    <div class="field">
      <label for="f-conv">Convidados <span class="opt">(até {site.capacidade})</span></label>
      <input type="number" id="f-conv" name="convidados" min="1" max={site.capacidade} inputmode="numeric" placeholder="Ex: 40" />
      <small class="err" id="err-convidados" role="alert"></small>
    </div>
    <div class="field">
      <label for="f-nome">Seu nome <abbr title="obrigatório">*</abbr></label>
      <input type="text" id="f-nome" name="nome" autocomplete="given-name" placeholder="Como te chamamos?" required />
      <small class="err" id="err-nome" role="alert"></small>
    </div>
  </div>

  <button type="submit" class="btn fill block">
    <span style="display:inline-flex;align-items:center;gap:12px"><svg viewBox="0 0 24 24" aria-hidden="true" style="width:18px;height:18px;fill:currentColor"><path d="M12.03 0C5.39 0 0 5.39 0 12.03c0 2.12.55 4.18 1.59 6L.05 24l6.11-1.6A12 12 0 0 0 12.03 24C18.68 24 24 18.62 24 11.97 24 5.32 18.68 0 12.03 0zm5.5 14.5c-.3-.15-1.79-.88-2.06-.98-.28-.1-.48-.15-.69.15-.2.3-.78.98-.96 1.19-.17.2-.35.23-.65.08-1.5-.76-2.59-1.42-3.57-3.08-.25-.44.31-.38.9-1.56.1-.2.05-.38-.03-.53-.07-.15-.68-1.65-.93-2.25-.25-.59-.5-.51-.69-.52h-.58c-.2 0-.53.08-.81.38-.28.3-1.06 1.03-1.06 2.52 0 1.49 1.08 2.92 1.24 3.13.15.2 2.13 3.25 5.16 4.56.72.31 1.28.5 1.72.63.72.23 1.38.2 1.9.12.58-.09 1.79-.73 2.04-1.44.25-.7.25-1.31.18-1.44-.08-.12-.28-.2-.58-.35z"/></svg>Enviar pelo WhatsApp</span>
  </button>
  <p class="form-ok" id="form-ok" role="status" hidden></p>
  <p class="form-note">Nada fica salvo neste site: a mensagem vai direto pro WhatsApp. Disponibilidade e sinal de 50% são combinados por lá. Ao enviar, você concorda com a <a href="/privacidade/" style="text-decoration:underline">Política de Privacidade</a>.</p>
</form>
