---
import Photo from './Photo.astro';
import Arrow from './Arrow.astro';
import { waLink } from '../data/conteudo';
interface Props { title?: string; text?: string; msg?: string }
const { title = 'Agende uma visita.', text = 'Datas limitadas, sujeitas à disponibilidade. Reserva com 50% de sinal.', msg } = Astro.props;
---
<section class="cta">
  <div class="cta-bg" aria-hidden="true"><Photo name="piscina-noite-2" sizes="100vw" /></div>
  <div class="wrap">
    <div class="orn top"><img src="/img/marca/ornamento-ouro.webp" width="880" height="64" alt="" /></div>
    <h2 data-split>{title}</h2>
    <p data-reveal>{text}</p>
    <div class="cta-btns" data-reveal>
      <a class="btn gold" href="/reservar/">Consultar minha data <Arrow /></a>
      <a class="btn line-d" href={waLink(msg)} target="_blank" rel="noopener noreferrer">WhatsApp <Arrow /></a>
    </div>
  </div>
</section>
