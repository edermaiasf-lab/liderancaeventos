---
import Photo from './Photo.astro';
interface Props { items: { img: string; alt: string }[]; group?: string }
const { items, group = 'mosaico' } = Astro.props;
const pad = (n: number) => String(n + 1).padStart(2, '0');
---
<div class={`mosaic-a n${Math.min(items.length, 9)}`} data-stagger>
  {items.map((it, i) => (
    <figure data-lb data-lb-group={group} data-src={`/img/${it.img}.webp`} data-alt={it.alt} tabindex="0" role="button" aria-label={`Ampliar: ${it.alt}`}>
      <Photo name={it.img} alt="" />
      <figcaption>Foto {pad(i)} — {it.alt}</figcaption>
    </figure>
  ))}
</div>
